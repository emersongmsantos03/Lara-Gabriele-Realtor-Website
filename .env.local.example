RESEND_API_KEY=your_resend_api_key_here
# Sender on a domain verified in Resend. Without it, the test sender only
# delivers to the Resend account owner, not to all lead inboxes.
RESEND_FROM="Lara Gabriele Website <website@pacificfriendlyrealty.com>"

# Wispr Properties off-market feed. Leave empty to keep the listings hidden —
# the section then shows the explanation and a locked preview only.
WISPR_API_URL=
WISPR_API_KEY=

# ---- Admin at /admin -------------------------------------------------------
# Initial login accounts, used only the first time (when the database has no
# accounts yet). Never put passwords in the repo — it is public. Create an entry
# per person with:  node scripts/hash-password.mjs <email> "<Name>"  and join
# entries with commas. After that, passwords are changed in /admin → Security.
ADMIN_USERS=
# Long random string (32+ characters). Encryption keys for 2-step verification
# secrets are derived from it, so never change it once people have set up 2FA:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
ADMIN_SESSION_SECRET=

# Database (PostgreSQL) for posts, accounts, sessions and visitor numbers.
# Vercel → Storage → "Neon" (Postgres) fills DATABASE_URL automatically.
# Without it, local development uses an embedded Postgres in .data/pglite.
DATABASE_URL=

# Photo uploads for posts: Vercel → Storage → "Blob" (fills this automatically).
# Without it, local dev saves to public/uploads/.
BLOB_READ_WRITE_TOKEN=
